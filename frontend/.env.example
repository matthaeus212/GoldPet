# 환경별 설정 파일 템플릿
# 복사하여 .env.local, .env.dev, .env.prod 생성

# 로컬 개발 (.env.local)
# VITE_API_BASE_URL=http://localhost:8081

# 개발 서버 (.env.dev)
# VITE_API_BASE_URL=https://api.mannamsquare.com

# 상용 서버 (.env.prod)
# VITE_API_BASE_URL=https://api.goldpet.com

VITE_API_BASE_URL=
VITE_ENV=
# 공유 URL 베이스 (ShareTarget URL 생성용)
# local: http://localhost:5173  |  dev: https://app.mannamsquare.com  |  prod: https://app.goldpet.com
VITE_APP_URL=
# GA4 측정 ID (예: G-XXXXXXXXXX). 비우면 애널리틱스 비활성(no-op).
VITE_GA_ID=
