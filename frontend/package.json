{
  "name": "react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node build-scripts/write-version.mjs",
    "build:dev": "tsc -b && vite build --mode dev && node build-scripts/write-version.mjs",
    "build:prod": "tsc -b && vite build --mode prod && node build-scripts/write-version.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepare": "husky",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:memory": "playwright test --project=chromium tests/e2e/walk-photo-memory.spec.ts",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:unit": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "generate:api": "openapi-typescript ../api/openapi.json -o src/api/schema.d.ts",
    "lint:contract": "bash build-scripts/check-no-literal-enums.sh"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.0.2",
    "@sentry/react": "10.55.0",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/react-query": "^5.90.10",
    "axios": "^1.15.0",
    "browser-image-compression": "^2.0.2",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "motion": "^12.34.3",
    "react": "^19.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "react-spinners": "^0.17.0",
    "recharts": "^3.8.1",
    "sockjs-client": "^1.6.1",
    "swiper": "^12.1.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-dom": "^19.2.3",
    "@types/sockjs-client": "^1.5.4",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "baseline-browser-mapping": "^2.9.19",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.6",
    "sass": "^1.97.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.0"
  }
}
