                </div>
                <!-- class 없으면 default, active 추가 하면 좋아요-->
                <div class="like_wrap">
                    <button type="button" class="now_chat">지금 채팅하기</button>
                </div>
            </div>
        </div>
    </div>
    <div class="more_wrap">
        <button type="button">더보기 <img src="../assets/images/common/more_btn.svg" alt=""></button>
    </div>
</div>
