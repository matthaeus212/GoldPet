{%- extends "_templates/_layout.njk" -%}
{% block content %}
<div id="friendFind">
    <!-- button class - active로 전환-->
    <div class="group_tab">
        <button type="button" class="active">친구찾기</button>
        <button type="button">친구목록</button>
    </div>
    <div class="find_filter">
        <ul>
            <li>
                <p>거리순</p>
                <div class="filter_list">
                    <div class="check_wrap">
                        <input type="checkbox" id="for1">
                        <label for="for1">1km 이내</label>
                    </div>
                    <div class="check_wrap">
                        <input type="checkbox" id="for2">
                        <label for="for2">3km 이내</label>
                    </div>
                    <div class="check_wrap">
                        <input type="checkbox" id="for3">
                        <label for="for3">5km 이내</label>
                    </div>
                </div>
            </li>
            <li>
                <p>반려동물 <br>종류</p>
                <div class="filter_list">
                    <div class="check_wrap">
                        <input type="checkbox" id="for4">
                        <label for="for4">강아지</label>
                    </div>
                    <div class="check_wrap">
                        <input type="checkbox" id="for5">
                        <label for="for5">고양이</label>
                    </div>
                    <div class="check_wrap">
                        <input type="checkbox" id="for6">
                        <label for="for6">파충류</label>
                    </div>
                    <div class="check_wrap">
                        <input type="checkbox" id="for7">
                        <label for="for7">곤충</label>
                    </div>
                    <div class="check_wrap">
                        <input type="checkbox" id="for8">
                        <label for="for8">반려조</label>
                    </div>
                    <div class="check_wrap">
                        <input type="checkbox" id="for9">
                        <label for="for9">어류</label>
                    </div>
                </div>
            </li>
            <li>
                <p>성별</p>
                <div class="filter_list">
                    <div class="check_wrap">
                        <input type="checkbox" id="for10">
                        <label for="for10">남아</label>
                    </div>
                    <div class="check_wrap">
                        <input type="checkbox" id="for11">
                        <label for="for11">여아</label>
                    </div>
                </div>
            </li>
            <li>
                <p>등록순</p>
                <div class="filter_list">
                    <div class="check_wrap">
                        <input type="checkbox" id="for12">
                        <label for="for12">등록순</label>
                    </div>
                    <div class="check_wrap">
                        <input type="checkbox" id="for13">
                        <label for="for13">인기순</label>
                    </div>
                </div>
            </li>
        </ul>
        <div class="btn_wrap">
            <button type="button">초기화</button>
            <button type="button">적용</button>
        </div>
    </div>

    <div class="friend_list">
        <div class="list_wrap">
            <div class="img_wrap">
                <!--사진 상단 왼쪽 아이콘-->
                <img src="../assets/images/main/main_slide_icon01.svg" class="icon_img" alt="">
                <!--메인 반려동물 이미지-->
                <div class="pet_img_wrap">
                    <div class="swiper-wrapper">
                        <div class="swiper-slide"><img src="../assets/images/main/main_slide_img01.png" class="pet_img" alt=""></div>
                        <div class="swiper-slide"><img src="../assets/images/main/main_slide_img01.png" class="pet_img" alt=""></div>
                        <div class="swiper-slide"><img src="../assets/images/main/main_slide_img01.png" class="pet_img" alt=""></div>
                    </div>
                    <div class="swiper-pet-prev"></div>
                    <div class="swiper-pet-next"></div>
                </div>
                <!--사진 하단 오른쪽 집사 이미지-->
                <div class="butler_img">
                    <img src="../assets/images/main/main_slide_butler01.jpg" alt="집사 이미지">
                </div>
            </div>
            <div class="txt_wrap">
                <!--남자의 경우 img src ../assets/images/main/man_icon.svg -->
                <h2>멍텅구리 <img src="../assets/images/main/woman_icon.svg" alt="여자 icon"></h2>
                <!-- neutering_on 붙이면 중성화 ok 노출 -->
                <p>중성화 OK</p>
            </div>
            <div class="pet_detail">
                <p>
                    5개월 ∙ 코숏 치즈 <br>
                    서울 강남구 ∙ 1km 이내
                </p>
                <br>
                <p>엄청 활발하고 산책에 적극적인 아이랍니다! : )</p>
                <div class="wish_dot">
                    <p class="label1">중성화 완료</p>
                    <p class="label2">매우 활발함</p>
                    <p class="label3">견과류 주의 필요</p>
                    <p class="label4">산책 매우 좋아함</p>
                </div>
                <!-- class 없으면 default, active 추가 하면 좋아요-->
                <div class="like_wrap">
                    <button type="button" class="dislike_btn"><img src="../assets/images/common/dislike_btn.svg" alt="">싫어요</button>
                    <button type="button" class="like_btn"><img src="../assets/images/common/like_btn.svg" alt="">좋아요</button>
                </div>
            </div>
        </div>
        <div class="list_wrap">
            <div class="img_wrap">
                <!--사진 상단 왼쪽 아이콘-->
